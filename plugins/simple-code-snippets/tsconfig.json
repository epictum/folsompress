{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"lib": ["es2024", "DOM", "DOM.Iterable"],
		"types": ["@cloudflare/workers-types"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*", "tests/**/*"]
}
