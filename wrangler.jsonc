{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "folsompress",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Run the Worker next to the D1 primary (WNAM) so each query is a short
	// hop instead of a cross-region round trip. EmDash recommends this for
	// server-rendered pages. ROLLBACK: delete this block and redeploy.
	"placement": {
		"mode": "targeted",
		"region": "aws:us-west-1",
	},
	// Runtime variables (kept in sync with the Cloudflare dashboard)
	"vars": {
		"EMDASH_SITE_URL": "https://folsompress.michael-a46.workers.dev",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "folsompress","database_id": "2dafe295-3d79-41bb-b710-a1ad39e9753a",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "folsompress-media","preview_bucket_name": "folsompress-media",
		},
	],
	// Astro session storage. Pinned to the namespace production already uses so
	// that `wrangler preview` (branch preview builds) can deploy; production
	// deploys previously auto-filled this ID.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "b9d6576ccc3c41d4bc825ec58928983a",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Observability (kept in sync with the Cloudflare dashboard)
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true,
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true,
		},
		"issue_detection": {
			"enabled": false,
		},
	},
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
