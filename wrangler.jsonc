{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "folsompress",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Run the Worker next to the D1 primary so each query is a short hop
	// instead of a cross-region round trip. EmDash recommends this for
	// server-rendered pages. The primary is served from LAX (D1 query meta:
	// served_by_colo), so target Google Cloud us-west2 (Los Angeles).
	// ROLLBACK: delete this block and redeploy.
	"placement": {
		"mode": "targeted",
		"region": "gcp:us-west2",
	},
	// Runtime variables (kept in sync with the Cloudflare dashboard)
	"vars": {
		"EMDASH_SITE_URL": "https://folsompress.michael-a46.workers.dev",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "folsompress","database_id": "2dafe295-3d79-41bb-b710-a1ad39e9753a",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "folsompress-media","preview_bucket_name": "folsompress-media",
		},
	],
	// Branch preview builds (`wrangler preview`) need an explicit ID for Astro's
	// session store; production deploys fill it in automatically. Points at the
	// same namespace production already uses.
	"previews": {
		"kv_namespaces": [
			{
				"binding": "SESSION",
				"id": "b9d6576ccc3c41d4bc825ec58928983a",
			},
		],
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Observability (kept in sync with the Cloudflare dashboard)
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true,
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true,
		},
		"issue_detection": {
			"enabled": false,
		},
	},
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
